{
  "permissions": {
    "deny": [
      "Bash(git checkout -b:*)",
      "Bash(git checkout -B:*)",
      "Bash(git checkout -q -b:*)",
      "Bash(git checkout -q -B:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/guard-hook.sh edit",
            "timeout": 600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/guard-hook.sh task",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
