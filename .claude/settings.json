{
  "autoMemoryEnabled": false,
  "permissions": {
    "deny": [
      "Bash(git checkout -b:*)",
      "Bash(git checkout -B:*)",
      "Bash(git checkout -q -b:*)",
      "Bash(git checkout -q -B:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hook.sh guard edit",
            "timeout": 600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hook.sh guard task",
            "timeout": 600
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hook.sh policies",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
